<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" prefHeight="710.0" prefWidth="1040.0" spacing="25.0" styleClass="game-container" stylesheets="@jeuDame.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.iutrodez.jeudedame.controleur.Controleur">
   <children>
      <!-- Cadre du damier 10x10 -->
      <VBox alignment="CENTER" styleClass="board-frame">
         <children>
            <GridPane fx:id="gameGrid" alignment="CENTER" maxHeight="600.0" maxWidth="600.0" minHeight="600.0" minWidth="600.0" prefHeight="600.0" prefWidth="600.0" styleClass="game-board">
              <columnConstraints>
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
                <ColumnConstraints hgrow="NEVER" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
                <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="NEVER" />
              </rowConstraints>
            </GridPane>
         </children>
      </VBox>

      <!-- Panneau latéral / Tableau de bord -->
      <VBox alignment="TOP_CENTER" maxHeight="630.0" prefHeight="630.0" prefWidth="350.0" spacing="12.0" styleClass="sidebar-panel">
         <children>
            <!-- Logo & En-tête -->
            <HBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="panel-title" text="Jeu de" />
                  <Label styleClass="panel-title-accent" text="Dames" />
               </children>
               <VBox.margin>
                  <Insets bottom="2.0" />
               </VBox.margin>
            </HBox>

            <!-- Actions rapides (grille 2x2 lisible sans troncature) -->
            <GridPane alignment="CENTER" hgap="8.0" maxWidth="310.0" prefWidth="310.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="50.0" />
                  <ColumnConstraints percentWidth="50.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="34.0" prefHeight="34.0" />
                  <RowConstraints minHeight="34.0" prefHeight="34.0" />
               </rowConstraints>
               <children>
                  <Button fx:id="btnSauvegarder" maxWidth="Infinity" mnemonicParsing="false" styleClass="action-btn" text="💾  Sauvegarder" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Button fx:id="btnRecommencer" maxWidth="Infinity" mnemonicParsing="false" styleClass="action-btn" text="🔄  Rejouer" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Button fx:id="boutonAmpoule" maxWidth="Infinity" mnemonicParsing="false" styleClass="action-btn" text="📖  Règles" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Button fx:id="btnAccueil" maxWidth="Infinity" mnemonicParsing="false" styleClass="action-btn" text="🏠  Menu" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
               <VBox.margin>
                  <Insets bottom="4.0" top="2.0" />
               </VBox.margin>
            </GridPane>

            <!-- Mode de jeu badge -->
            <Label fx:id="modeLabel" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;" text="Mode : 2 Joueurs Local" />

            <!-- Badge du Tour -->
            <HBox fx:id="turnBadge" alignment="CENTER" prefHeight="42.0" styleClass="turn-badge">
               <children>
                  <Label fx:id="playerTurnLabel" styleClass="turn-badge-text" text="Tour des Blancs" />
               </children>
            </HBox>

            <!-- Carte Joueur Blanc -->
            <HBox fx:id="cardBlanc" alignment="CENTER_LEFT" prefHeight="64.0" styleClass="player-score-card">
               <children>
                  <StackPane fx:id="avatarBlancContainer" alignment="CENTER" prefHeight="48.0" prefWidth="48.0" />
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <children>
                        <Label fx:id="nomJoueurBlancLabel" styleClass="player-name" text="Joueur Blanc" />
                        <Label fx:id="nombreDePionBlanc" styleClass="player-pawns-count" text="20 pions restants" />
                     </children>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>

            <!-- Carte Joueur Noir -->
            <HBox fx:id="cardNoir" alignment="CENTER_LEFT" prefHeight="64.0" styleClass="player-score-card">
               <children>
                  <StackPane fx:id="avatarNoirContainer" alignment="CENTER" prefHeight="48.0" prefWidth="48.0" />
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <children>
                        <Label fx:id="nomJoueurNoirLabel" styleClass="player-name" text="Joueur Noir" />
                        <Label fx:id="nombreDePionNoir" styleClass="player-pawns-count" text="20 pions restants" />
                     </children>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>

            <!-- Chronomètre -->
            <HBox alignment="CENTER" prefHeight="46.0" styleClass="timer-box">
               <children>
                  <Label text="⏱ " textFill="#94a3b8">
                     <font>
                        <javafx.scene.text.Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="chronometre" styleClass="timer-label" text="00 : 00 : 00" />
               </children>
               <VBox.margin>
                  <Insets top="2.0" />
               </VBox.margin>
            </HBox>

            <!-- Zone de statut / guidance joueur -->
            <HBox alignment="CENTER" prefHeight="48.0" styleClass="status-box">
               <children>
                  <Label fx:id="statutLabel" styleClass="status-text" text="Sélectionnez un pion pour jouer" />
               </children>
               <VBox.margin>
                  <Insets top="2.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
   </padding>
</HBox>
